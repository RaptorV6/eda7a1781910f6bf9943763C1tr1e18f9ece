@page
@model IndexModel
@{
    ViewData["Title"] = Model.PanelTitle;
    var configuredBaseUrl = string.IsNullOrWhiteSpace(Model.CitrixBaseUrl)
        ? "Není nastaveno"
        : Model.CitrixBaseUrl;
}

<style>
    .citrix-diagnostics-panel {
        border: 1px solid #d9e2ec;
        border-radius: 1rem;
        background: #ffffff;
        box-shadow: 0 1rem 2rem rgba(15, 23, 42, 0.06);
        padding: 1.5rem;
    }

    .citrix-diagnostics-title {
        margin-bottom: 0.25rem;
        font-size: 1.75rem;
        font-weight: 700;
    }

    .citrix-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .citrix-info-card {
        border: 1px solid #d9e2ec;
        background: #f8fafc;
        border-radius: 0.65rem;
        padding: 0.85rem 1rem;
    }

    .citrix-info-label {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #52606d;
        font-weight: 700;
        margin-bottom: 0.35rem;
    }

    .citrix-info-value {
        display: block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.9rem;
        color: #102a43;
        word-break: break-all;
    }

    .citrix-info-hint {
        margin-top: 0.4rem;
        font-size: 0.8rem;
        color: #627d98;
    }

    .citrix-info-endpoints {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.85rem;
        color: #243b53;
    }

    .citrix-info-endpoints li {
        margin-bottom: 0.4rem;
        padding-left: 0.65rem;
        border-left: 2px solid #cbd5e1;
        word-break: break-word;
    }

    .citrix-info-endpoints li:last-child {
        margin-bottom: 0;
    }

    .citrix-info-howto {
        margin-bottom: 1.5rem;
        border: 1px solid #d9e2ec;
        border-radius: 0.65rem;
        background: #fffbeb;
        padding: 0.5rem 1rem;
    }

    .citrix-info-howto > summary {
        cursor: pointer;
        font-weight: 700;
        color: #78350f;
        padding: 0.5rem 0;
        user-select: none;
    }

    .citrix-howto-body {
        padding: 0.5rem 0 1rem;
        font-size: 0.9rem;
        line-height: 1.55;
        color: #1f2937;
    }

    .citrix-howto-body h3 {
        margin-top: 1.25rem;
        margin-bottom: 0.5rem;
        font-size: 1.05rem;
        color: #0f172a;
    }

    .citrix-howto-body h3:first-child {
        margin-top: 0.5rem;
    }

    .citrix-howto-body ol,
    .citrix-howto-body ul {
        margin: 0 0 0.5rem;
        padding-left: 1.5rem;
    }

    .citrix-howto-body code {
        background: #f1f5f9;
        padding: 0.05rem 0.3rem;
        border-radius: 0.3rem;
        font-size: 0.85rem;
    }

    .citrix-diagnostics-status {
        font-weight: 700;
        margin: 0.5rem 0 1rem;
        min-height: 1.25rem;
    }

    .citrix-diagnostics-status:empty {
        display: none;
    }

    .citrix-diagnostics-details {
        margin-top: 1.5rem;
        border-top: 1px solid #d9e2ec;
        padding-top: 1rem;
    }

    .citrix-diagnostics-details summary {
        cursor: pointer;
        color: #52606d;
        font-size: 0.9rem;
        user-select: none;
    }

    .citrix-diagnostics-status[data-level="info"] {
        color: #0f172a;
    }

    .citrix-diagnostics-status[data-level="warn"] {
        color: #b45309;
    }

    .citrix-diagnostics-status[data-level="error"] {
        color: #b42318;
    }

    .citrix-diagnostics-status[data-level="success"] {
        color: #047857;
    }

    .citrix-login-button {
        border: 0;
        border-radius: 0.65rem;
        background: #0f766e;
        color: #ffffff;
        font-weight: 700;
        padding: 0.75rem 1rem;
        cursor: pointer;
    }

    .citrix-login-button:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    .citrix-spinner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0.5rem 0 1rem;
        color: #52606d;
        font-size: 0.95rem;
    }

    .citrix-spinner.d-none {
        display: none;
    }

    .citrix-spinner-dot {
        width: 1.15rem;
        height: 1.15rem;
        border: 3px solid #cbd5e1;
        border-top-color: #0f766e;
        border-radius: 50%;
        animation: citrix-spin 0.8s linear infinite;
        flex-shrink: 0;
    }

    @@keyframes citrix-spin {
        to { transform: rotate(360deg); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .citrix-spinner-dot { animation-duration: 2s; }
    }

    .citrix-retry {
        margin: 0.5rem 0 1rem;
    }

    .citrix-retry.d-none {
        display: none;
    }

    .citrix-app-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.75rem;
    }

    .citrix-app-item {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.85rem 1rem;
        border-radius: 0.85rem;
        border: 1px solid #d9e2ec;
        background: #f8fafc;
    }

    .citrix-app-icon {
        width: 42px;
        height: 42px;
        object-fit: contain;
        border-radius: 0.65rem;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        padding: 0.25rem;
        flex-shrink: 0;
    }

    .citrix-app-name {
        font-weight: 600;
        color: #102a43;
    }

    .citrix-empty-state {
        color: #52606d;
        margin-bottom: 0;
    }

    .citrix-diagnostics-log {
        margin-top: 1rem;
        margin-bottom: 0;
        padding: 1rem;
        min-height: 18rem;
        max-height: 30rem;
        overflow: auto;
        border-radius: 0.85rem;
        background: #0f172a;
        color: #e2e8f0;
        white-space: pre-wrap;
        font-size: 0.875rem;
        line-height: 1.45;
    }

    .citrix-api-link-list {
        list-style: none;
        margin: 0.25rem 0 0.75rem;
        padding: 0;
    }

    .citrix-api-link-list li {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        flex-wrap: wrap;
        padding: 0.45rem 0;
        border-bottom: 1px solid #fde68a;
        font-size: 0.9rem;
        color: #1f2937;
    }

    .citrix-api-link-list li:last-child {
        border-bottom: none;
    }

    .citrix-api-btn {
        border: 1px solid #92400e;
        border-radius: 0.4rem;
        background: #fffbeb;
        color: #92400e;
        font-weight: 600;
        padding: 0.3rem 0.7rem;
        font-size: 0.85rem;
        cursor: pointer;
        flex-shrink: 0;
    }

    .citrix-api-btn:hover {
        background: #fef3c7;
    }

    .citrix-api-btn:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    .citrix-flow-steps {
        margin: 0.25rem 0 0.5rem;
        padding-left: 1.5rem;
        font-size: 0.88rem;
        line-height: 1.65;
        color: #1f2937;
    }

    .citrix-flow-steps li {
        margin-bottom: 0.35rem;
    }
</style>

<div id="citrix-diagnostics-root"
     class="citrix-diagnostics-panel"
     data-base-url="@Model.CitrixBaseUrl"
     data-panel-title="@Model.PanelTitle"
     data-body-preview-limit="@Model.BodyPreviewLimit"
     data-client-log-endpoint="@Model.ClientLogEndpoint"
     data-server-probe-endpoint="@Model.ServerProbeEndpoint"
     data-server-login-endpoint="@Model.ServerLoginEndpoint"
     data-server-sso-endpoint="@Model.ServerSsoEndpoint"
     data-sso-bridge-url="@Model.SsoBridgeUrl"
     data-request-id="@Model.DiagnosticRequestId">
    <div class="mb-3">
        <h1 class="citrix-diagnostics-title">@Model.PanelTitle</h1>
    </div>

    <div class="citrix-info-grid">
        <div class="citrix-info-card">
            <div class="citrix-info-label">Citrix StoreFront (server-side)</div>
            <code class="citrix-info-value">@configuredBaseUrl</code>
            <div class="citrix-info-hint">Interní hostname pro auth a Resources/List. <code>citrixgw01</code> = NetScaler gateway (ověřeno funkční). <code>pnagent.fis.acr</code> = přímý StoreFront, doporučeno správcem pro server-side volání, zatím netestováno pro celý auth flow.</div>
        </div>
        <div class="citrix-info-card">
            <div class="citrix-info-label">Public gateway (klient-side ICA)</div>
            <code class="citrix-info-value">@(string.IsNullOrWhiteSpace(Model.PublicGatewayHost) ? "(nenastaveno)" : Model.PublicGatewayHost)</code>
            <div class="citrix-info-hint">Hostname kam Citrix Workspace App fetchne ICA přes <code>receiver://</code>. Server-side host je interní → klient by ho neviděl, proto rewrite.</div>
        </div>
        <div class="citrix-info-card">
            <div class="citrix-info-label">Backend endpointy</div>
            <ul class="citrix-info-endpoints">
                <li><code>POST @Model.ServerLoginEndpoint</code> — bootstrap → ExplicitForms login → Resources/List</li>
                <li><code>POST @Model.LaunchStatusEndpoint</code> — GetLaunchStatus + rewrite fileFetchUrl na public host</li>
                <li><code>GET @Model.ProxyEndpoint</code> — ICA + ikony stream s cached cookies (whitelist <code>Resources/*</code>)</li>
            </ul>
        </div>
    </div>

    <details class="citrix-info-howto">
        <summary>Jak to funguje — vysvětlení po lopatě</summary>
        <div class="citrix-howto-body">
            <h3>Pro představu</h3>
            <p>
                Citrix StoreFront je server u nás ve firmě, na kterém jsou napojené virtualizované aplikace (GINIS, Edge, Visual Studio…). Má vlastní webovou stránku, která se ale nedá pěkně vložit do našeho portálu. Tenhle PoC je <strong>tlumočník</strong>: uživatel mluví s naším portálem česky, portál to za něj přeloží do jazyka Citrixu a zase zpět.
            </p>

            <h3>Co se děje, když se uživatel přihlásí</h3>
            <p>
                Uživatel napíše jméno, heslo a doménu do našeho formuláře. <strong>Naše stránka</strong> ty údaje pošle <strong>našemu serveru</strong>. Náš server pak odehrává roli "robotického prohlížeče" — projde celé Citrix přihlášení místo uživatele, nasbírá si přístupové sušenky (cookies), získá seznam aplikací co má uživatel přidělené (nejsou pro každého stejné, Citrix admin to řídí v Citrix Studio podle skupin v Active Directory) a pošle ten seznam zpět našemu webu jako 9 dlaždic.
            </p>
            <p>
                <strong>Přístupové sušenky zůstávají u nás na serveru</strong>, prohlížeč uživatele je nikdy nedostane. Místo toho dostane jen náhodný kód (token), kterým se identifikuje, když chce klikat dál. Pokud by někdo prohlížeč napadl, dostane jen ten kód, ne klíče od Citrixu.
            </p>

            <h3>Co se děje, když uživatel klikne dlaždici</h3>
            <p>
                Klik dlaždice neznamená "spustit aplikaci tady v prohlížeči". Citrix aplikace běží na vzdáleném Citrix serveru a streamuje obraz do speciálního programu na uživatelově PC — tomu programu se říká <strong>Citrix Workspace App</strong> (musí ho mít každý, kdo chce Citrix aplikace pouštět; v korporátu typicky předinstalovaný IT-čkem).
            </p>
            <p>
                Klik na dlaždici tedy spustí tento řetězec:
            </p>
            <ol>
                <li>Náš portál se zeptá Citrixu: "Dej mi vstupenku pro tuhle aplikaci."</li>
                <li>Citrix vrátí jednorázovou vstupenku platnou 30 sekund.</li>
                <li>Náš portál tu vstupenku zabalí do speciálního odkazu ve formátu <code>receiver://...</code>. Tahle podivná schémat URL je registrované jako "rozumí jí Citrix Workspace App" — funguje stejně jako <code>mailto:</code> rozumí poštovní klient.</li>
                <li>Prohlížeč ten odkaz předá Workspace App nainstalované na PC.</li>
                <li>Workspace App si tu vstupenku vymění za otevřenou Citrix relaci a aplikace naběhne v jejím okně.</li>
            </ol>
            <p>
                <strong>Žádný download `.ica` souboru, žádné okno se stahováním.</strong> Klik → aplikace. Stejný UX jako kdyby uživatel používal oficiální Citrix StoreFront.
            </p>

            <h3>Přesný sled HTTP kroků při přihlášení (5 kroků)</h3>
            <p>Portál odehrává celý tok jako "robotický prohlížeč". Po odeslání formuláře se na serveru stane toto:</p>
            <ol class="citrix-flow-steps">
                <li><strong>Bootstrap GET</strong> <code>pnagent.fis.acr/Citrix/FISWeb/</code> s browser-like hlavičkami (bez <code>X-Requested-With</code>) → přímá odpověď <strong>200 OK</strong>, StoreFront nastaví <code>ASP.NET_SessionId</code> + <code>CsrfToken</code></li>
                <li><strong>POST</strong> <code>/Authentication/GetAuthMethods</code> → <strong>200 XML</strong> — StoreFront vrátí dostupné metody: <code>ExplicitForms</code>, <code>IntegratedWindows</code>, <code>CitrixAuth</code></li>
                <li><strong>POST</strong> <code>/ExplicitAuth/Login</code> → <strong>200 XML</strong> s definicí formulářových polí (jméno, heslo, doména, text tlačítka)</li>
                <li><strong>POST</strong> <code>/ExplicitAuth/LoginAttempt</code> s <code>username</code>, <code>password</code>, <code>domain</code>, <code>loginBtn=Přihlásit</code> + aktuálním <code>Csrf-Token</code> hlavičkou → <strong>200 XML</strong> s <code>&lt;Result&gt;success&lt;/Result&gt;</code></li>
                <li><strong>POST</strong> <code>/Resources/List</code> s <code>format=json&amp;resourceDetails=Default</code> → <strong>200 JSON</strong> se seznamem aplikací uživatele</li>
            </ol>
            <p>Všechny cookies zůstávají na serveru. Prohlížeč dostane jen opaque GUID (session token), pod kterým si server cookies drží 20 minut (sliding TTL).</p>
            <p class="citrix-info-hint" style="margin-top:0.5rem">Poznámka: Dřívější konfigurace používala <code>citrixgw01.fis.acr</code> (NetScaler gateway), kde bootstrap dělal 302 → <code>/cgi/setclient?wica</code> → meta-refresh loop (3 sub-kroky navíc). <code>pnagent.fis.acr</code> je přímý StoreFront — bez NetScaler, bez redirectů.</p>

            <h3>Proč jsme si byli jistí, že to funguje správně</h3>
            <p>
                Nejlepší kontrola: stáhli jsme vstupenku <code>.ica</code> z <strong>našeho</strong> portálu a porovnali ji s vstupenkou z <strong>oficiálního</strong> Citrix StoreFrontu pro tu samou aplikaci. Většina obsahu je jednorázová (každá vstupenka má svoje unikátní tokeny — to je správně), ale jeden konkrétní řádek <code>SessionsharingKey</code> je <strong>znak-po-znaku stejný</strong>. Tenhle klíč je deterministický kontrolní součet aplikace + serveru + konfigurace. Když se shoduje, znamená to: portál mluví se stejnou aplikací úplně stejným způsobem jako oficiální klient. Není to "podobné", je to <strong>funkčně ekvivalentní</strong>.
            </p>

            <h3>Co bylo zákeřné</h3>
            <p>
                Citrix neudržuje pro tenhle scénář dokumentaci. Většinu jsme museli odhalit experimentem (zachytit chování oficiálního klienta, porovnat s naším, najít rozdíl, opakovat). Pár věcí co nás zdrželo:
            </p>
            <ul>
                <li>
                    <strong>Citrix přesměrovává v cyklech, které žádný HTTP klient automaticky nezvládne.</strong> Mezi přihlášením je míchané HTTP přesměrování (rozumí mu prohlížeč) a HTML značka <code>&lt;meta refresh&gt;</code> (vypadá jako obyčejná stránka, ale ve skutečnosti přesměrovává). Museli jsme to celé odsledovat manuálně.
                </li>
                <li>
                    <strong>Citrix podle hlaviček pozná, kdo se ho ptá.</strong> Když naše požadavky vypadaly jako "z aplikace", odmítl vytvořit přihlášenou relaci. Když vypadaly jako "z prohlížeče" (jiné hlavičky), všechno prošlo. Trvalo to vytušit, protože chybová hláška to nikde neříkala — vypadalo to, že náhodně padá.
                </li>
                <li>
                    <strong>Tlačítko Přihlásit musí být v češtině.</strong> Citrix pole formuláře validuje proti přesnému textu na tlačítku. Když jsme posílali "Log On" (tak je to v dokumentaci), zamítl. Stačilo to změnit na "Přihlásit" a fungovalo. Tenhle StoreFront je česká instalace.
                </li>
                <li>
                    <strong>Bezpečnostní token (CSRF) se po každém kroku mění.</strong> Logické cache-ování token na začátku flow všechny další kroky rozbilo, protože server čekal nový token, ne starý.
                </li>
                <li>
                    <strong>Internal vs public hostname.</strong> Citrix vrátí vstupenku, která říká "stáhni si ICA z <em>interního</em> hostname". Jenže <strong>uživatelův počítač na interní adresu nedosáhne</strong> — Workspace App chodí přes <code>pnagent.fis.acr</code>. Bez přepsání hostname v naší odpovědi by se vstupenka nedala použít. Tohle nás zdrželo nejvíc — všechno fungovalo až do kliknutí, pak Workspace App tiše selhal bez chybové hlášky. Řešení: <code>appsettings.json::CitrixDiagnostics:PublicGatewayHost = pnagent.fis.acr</code> — server přepíše URL ve vstupenec před odesláním klientovi.
                </li>
                <li>
                    <strong>Workspace App musí mít přidaný store.</strong> Když uživatel <code>receiver://...</code> link kliknul a Workspace App neměla náš Citrix přidaný jako "známý účet", taky tiše selhala. Po přidání store v UI Workspace App (Add Account → URL discovery) všechno fungovalo. Pro celofiremní nasazení se tohle dá pushnout přes GPO s parametrem MSI instalace.
                </li>
            </ul>

            <h3>Co teď a co dál</h3>
            <p>
                <strong>Hotovo:</strong> přihlášení, výpis aplikací, ikony, klik → spuštění aplikace v Workspace App. End-to-end funkční, provoz přes <code>pnagent.fis.acr</code> (přímý StoreFront, bez NetScaler).
            </p>
            <p>
                <strong>V plánu pro ostrou verzi:</strong>
            </p>
            <ul>
                <li>
                    <strong>Automatické přihlášení — dvě cesty:</strong>
                    <ul style="margin-top:0.35rem">
                        <li><strong>Credential storage</strong> — uživatel zadá heslo jednou, portál si ho uloží šifrovaně. Každý další příchod = tichý login na pozadí, uživatel vidí rovnou dlaždice. Funguje pro všechny uživatele (ACR i FIS).</li>
                        <li><strong>Windows PassThrough (<code>DomainPassthroughAuth</code>)</strong> — portál na pozadí volá <code>pnagent.fis.acr/DomainPassthroughAuth/Login</code> s Windows identitou uživatele. Ten nikdy nezadá heslo. Vyžaduje Kerberos delegaci v AD (RBCD pro machine account serveru). Funguje pro FIS uživatele; ACR uživatelé potřebují změnu AD trustu.</li>
                    </ul>
                </li>
                <li><strong>Refactor kódu</strong> — současný PoC má hodně logiky v jednom souboru pro přehlednost. V ostré verzi se to rozdělí do služeb, přidají se testy.</li>
                <li><strong>Distribuovaná cache</strong> — pokud poběží portál na více serverech (load balancing), session cache musí být sdílená. Trivial fix (Redis), ale pro PoC zbytečné.</li>
            </ul>
        </div>
    </details>

    <details class="citrix-info-howto" id="citrix-api-tools">
        <summary>Testovací API endpointy (klikni pro rozbalení)</summary>
        <div class="citrix-howto-body">
            <h3>GET endpointy — otevřou se v nové záložce</h3>
            <ul class="citrix-api-link-list">
                <li>
                    <a href="/api/whoami" target="_blank" rel="noopener"><code>/api/whoami</code></a>
                    — Windows identita serveru: jméno účtu, autentizace, impersonation level (klíčové pro SSO diagnostiku)
                </li>
                <li>
                    <a href="/api/citrix-sso/test" target="_blank" rel="noopener"><code>/api/citrix-sso/test</code></a>
                    — SSO test: zkusí Kerberos/NTLM handshake na StoreFront, vrátí impersonation level, chybový kód a cookies
                </li>
            </ul>

            <h3>POST endpointy — výsledek se zobrazí v diagnostickém logu níže</h3>
            <ul class="citrix-api-link-list">
                <li>
                    <button type="button" class="citrix-api-btn" id="btn-server-probe">▶ Spustit server probe</button>
                    <code>POST /api/citrix-diagnostics/server-probe</code>
                    — bootstrap GET na StoreFront ze serveru, vrátí status kódy, hlavičky, CSRF token, cookies
                </li>
            </ul>
            <p class="citrix-info-hint">Login (<code>POST /api/citrix-diagnostics/explicit-login</code>) se spouští formulářem výše — není potřeba duplicitní tlačítko.</p>
        </div>
    </details>

    <div id="citrix-status" class="citrix-diagnostics-status" data-level="info"></div>

    <div id="citrix-spinner" class="citrix-spinner" role="status" aria-live="polite">
        <span class="citrix-spinner-dot" aria-hidden="true"></span>
        <span class="citrix-spinner-label">Načítám vaše aplikace…</span>
    </div>

    <div id="citrix-retry" class="citrix-retry d-none">
        <button type="button" id="citrix-retry-button" class="citrix-login-button">Zkusit znovu</button>
    </div>

    <div id="citrix-apps">
        <ul id="citrix-app-list" class="citrix-app-list"></ul>
        <p id="citrix-empty-state" class="citrix-empty-state d-none"></p>
    </div>

    <details class="citrix-diagnostics-details">
        <summary>Diagnostika (rozbalit)</summary>
        <pre id="citrix-log" class="citrix-diagnostics-log"></pre>
    </details>
</div>

@section Scripts {
    <script>
        (() => {
            const root = document.getElementById('citrix-diagnostics-root');
            if (!root) {
                return;
            }

            // Strategie tichého SSO. "bridge" = celý ověřený flow běží same-origin
            // uvnitř skrytého iframe na serveru 07 a výsledek přiletí přes postMessage.
            // "broker" (cross-origin fetch flow z i15) není v tomto buildu — vyžaduje
            // samostatný citrix-api.js modul + kompletní CORS na 07.
            const STRATEGY = 'bridge';

            const statusElement = document.getElementById('citrix-status');
            const appListElement = document.getElementById('citrix-app-list');
            const emptyStateElement = document.getElementById('citrix-empty-state');
            const logElement = document.getElementById('citrix-log');
            const spinnerElement = document.getElementById('citrix-spinner');
            const retryElement = document.getElementById('citrix-retry');
            const retryButtonElement = document.getElementById('citrix-retry-button');

            const showSpinner = (message) => {
                if (!spinnerElement) {
                    return;
                }
                const label = spinnerElement.querySelector('.citrix-spinner-label');
                if (label && message) {
                    label.textContent = message;
                }
                spinnerElement.classList.remove('d-none');
            };

            const hideSpinner = () => {
                spinnerElement?.classList.add('d-none');
            };

            const showRetry = (visible) => {
                retryElement?.classList.toggle('d-none', !visible);
            };

            const rawBaseUrl = (root.dataset.baseUrl || '').trim();
            const normalizedBaseUrl = rawBaseUrl ? rawBaseUrl.replace(/\/?$/, '/') : '';
            const bodyPreviewLimit = Number.parseInt(root.dataset.bodyPreviewLimit || '1200', 10) || 1200;
            const clientLogEndpoint = root.dataset.clientLogEndpoint || '';
            const serverProbeEndpoint = root.dataset.serverProbeEndpoint || '';
            const serverLoginEndpoint = root.dataset.serverLoginEndpoint || '';
            const serverSsoEndpoint = root.dataset.serverSsoEndpoint || '';
            const ssoBridgeUrl = root.dataset.ssoBridgeUrl || '';
            const requestId = root.dataset.requestId || `client-${Date.now()}`;
            let clientLogSequence = 0;

            const setStatus = (message, level) => {
                statusElement.textContent = message;
                statusElement.dataset.level = level;
            };

            const appendLogLine = (level, message) => {
                const timestamp = new Date().toISOString();
                logElement.textContent += `[${timestamp}] [${level}] ${message}\n`;
                logElement.scrollTop = logElement.scrollHeight;
            };

            const sendServerLog = async (level, step, message) => {
                if (!clientLogEndpoint) {
                    return;
                }

                try {
                    const response = await fetch(clientLogEndpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            requestId,
                            level,
                            step,
                            message: `#${++clientLogSequence} ${message}`,
                            browserTimestamp: new Date().toISOString(),
                            pagePath: window.location.pathname
                        })
                    });

                    if (!response.ok) {
                        appendLogLine('WARN', `Server log mirror failed with status ${response.status}.`);
                    }
                } catch (error) {
                    appendLogLine('WARN', `Server log mirror fetch failed: ${error instanceof Error ? error.message : String(error)}`);
                }
            };

            const writeLog = (level, step, message, consoleWriter) => {
                consoleWriter(`[${step}] ${message}`);
                appendLogLine(level, `${step}: ${message}`);
                void sendServerLog(level, step, message);
            };

            const log = {
                info(step, message) {
                    writeLog('INFO', step, message, console.log);
                },
                warn(step, message) {
                    writeLog('WARN', step, message, console.warn);
                },
                error(step, message) {
                    writeLog('ERROR', step, message, console.error);
                }
            };

            const truncate = (value) => {
                if (value == null) {
                    return '';
                }

                const text = String(value);
                return text.length > bodyPreviewLimit
                    ? `${text.slice(0, bodyPreviewLimit)}... [zkráceno]`
                    : text;
            };

            const getSafeJsonPreview = (value) => {
                try {
                    return truncate(JSON.stringify(value, null, 2));
                } catch (error) {
                    return `JSON preview selhal: ${error instanceof Error ? error.message : String(error)}`;
                }
            };

            const logMultilineBlock = (stepName, label, value) => {
                if (!value) {
                    return;
                }

                log.info(stepName, `${label}:\n${truncate(value)}`);
            };

            const getAccessibleHeaders = (response) => {
                const headers = {};

                response.headers.forEach((value, key) => {
                    headers[key] = value;
                });

                return headers;
            };

            const getCookieValue = (cookieName) => {
                const escapedName = cookieName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                const match = document.cookie.match(new RegExp(`(?:^|; )${escapedName}=([^;]*)`));
                return match ? decodeURIComponent(match[1]) : '';
            };

            const joinUrl = (baseUrl, relativeOrAbsoluteUrl) => {
                try {
                    return new URL(relativeOrAbsoluteUrl, baseUrl).toString();
                } catch (error) {
                    log.warn('UrlJoin', `Nepodařilo se složit URL z hodnoty "${relativeOrAbsoluteUrl}": ${error instanceof Error ? error.message : String(error)}`);
                    return relativeOrAbsoluteUrl;
                }
            };

            const createTransactionId = () => {
                if (window.crypto && typeof window.crypto.randomUUID === 'function') {
                    return window.crypto.randomUUID();
                }

                return `diag-${Date.now()}-${Math.random().toString(16).slice(2)}`;
            };

            const createCitrixHeaders = ({ httpsHeaderValue, csrfToken = '', includeContentType = false } = {}) => {
                const headers = {
                    'Citrix-TransactionId': createTransactionId(),
                    'X-Citrix-IsUsingHTTPS': httpsHeaderValue,
                    'X-Requested-With': 'XMLHttpRequest'
                };

                if (includeContentType) {
                    headers['Content-Type'] = 'application/x-www-form-urlencoded; charset=UTF-8';
                }

                if (csrfToken) {
                    headers['Csrf-Token'] = csrfToken;
                }

                return headers;
            };

            const logResponse = (stepName, requestUrl, method, response, responseText) => {
                log.info(stepName, `request ${method} ${requestUrl}`);
                log.info(stepName, `status ${response.status} ${response.statusText || ''}`.trim());
                log.info(stepName, `redirected=${response.redirected}, finalUrl=${response.url || '(neznámé)'}`);
                log.info(stepName, `content-type=${response.headers.get('content-type') || '(neznámé)'}`);

                const headers = getAccessibleHeaders(response);
                if (Object.keys(headers).length > 0) {
                    log.info(stepName, `Čitelné response hlavičky: ${getSafeJsonPreview(headers)}`);
                }

                const challengeHeader = response.headers.get('CitrixWebReceiver-Authenticate');
                if (challengeHeader) {
                    log.warn(stepName, `CitrixWebReceiver-Authenticate=${challengeHeader}`);
                }

                const preview = truncate(responseText);
                if (preview) {
                    log.info(stepName, `body preview=${preview}`);
                } else {
                    log.info(stepName, 'body preview je prázdný.');
                }
            };

            const runProbe = async (stepName, requestUrl, requestOptions) => {
                log.info(stepName, `Spouštím request ${requestOptions.method || 'GET'} ${requestUrl}`);

                const response = await fetch(requestUrl, requestOptions).catch((error) => {
                    log.error(stepName, `Fetch selhal: ${error instanceof Error ? error.message : String(error)}`);
                    throw error;
                });

                const responseText = await response.text();
                logResponse(stepName, requestUrl, requestOptions.method || 'GET', response, responseText);

                if (looksLikeUnauthorized(response, responseText)) {
                    log.warn(stepName, 'Odpověď vypadá jako unauthorized / auth challenge / redirect na login.');
                }

                return {
                    response,
                    responseText
                };
            };

            const runServerSideProbe = async (stepName, requestUrl, requestOptions) => {
                if (!serverProbeEndpoint) {
                    log.warn(stepName, 'Server-side probe endpoint není nastaven.');
                    return null;
                }

                const normalizedHeaders = {};
                const sourceHeaders = requestOptions.headers || {};

                if (sourceHeaders instanceof Headers) {
                    sourceHeaders.forEach((value, key) => {
                        normalizedHeaders[key] = value;
                    });
                } else {
                    Object.assign(normalizedHeaders, sourceHeaders);
                }

                const bodyValue = typeof requestOptions.body === 'string'
                    ? requestOptions.body
                    : requestOptions.body instanceof URLSearchParams
                        ? requestOptions.body.toString()
                        : requestOptions.body == null
                            ? ''
                            : String(requestOptions.body);

                log.info(stepName, `Spouštím server-side probe přes ${serverProbeEndpoint}`);

                try {
                    const response = await fetch(serverProbeEndpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            requestId,
                            step: stepName,
                            storeRootUrl: normalizedBaseUrl,
                            url: requestUrl,
                            method: requestOptions.method || 'GET',
                            body: bodyValue,
                            contentType: normalizedHeaders['Content-Type'] || normalizedHeaders['content-type'] || '',
                            headers: normalizedHeaders
                        })
                    });

                    const probeText = await response.text();
                    let probePayload = null;

                    try {
                        probePayload = JSON.parse(probeText);
                    } catch (error) {
                        log.error(stepName, `Server-side probe vrátil nevalidní JSON: ${truncate(probeText)}`);
                        return null;
                    }

                    log.info(stepName, `Server-side probe výsledek: ${getSafeJsonPreview(probePayload)}`);
                    return probePayload;
                } catch (error) {
                    log.error(stepName, `Server-side probe selhal: ${error instanceof Error ? error.message : String(error)}`);
                    return null;
                }
            };

            const explainServerSideProbe = (stepName, probePayload) => {
                if (!probePayload) {
                    return;
                }

                const bootstrapLocation = probePayload.bootstrapHeaders?.Location || probePayload.bootstrapHeaders?.location || '';

                if (probePayload.bootstrapStatusCode === 302 && bootstrapLocation) {
                    log.warn(stepName, `Bootstrap store root skončil redirectem na ${bootstrapLocation}`);
                }

                if (probePayload.bootstrapStatusCode === 302
                    && probePayload.bootstrapCsrfTokenFound === false
                    && Array.isArray(probePayload.bootstrapCookieNames)
                    && probePayload.bootstrapCookieNames.length > 0) {
                    log.warn(
                        stepName,
                        `Server-side probe má jen gateway cookies (${probePayload.bootstrapCookieNames.join(', ')}), ale nezískal StoreFront CsrfToken. To je nová neautentizovaná session, ne vaše browser session.`
                    );
                }

                if (probePayload.statusCode === 404 && probePayload.bootstrapCsrfTokenFound === false) {
                    log.warn(
                        stepName,
                        'HTTP 404 tady není hlavní problém. Hlavní problém je chybějící authenticated StoreFront session a CSRF token.'
                    );
                }

                if (window.location.origin !== new URL(normalizedBaseUrl).origin) {
                    log.warn(
                        stepName,
                        'CitrixComponent běží na jiném originu než Citrix StoreFront. Browser requesty proto narážejí na CORS/SameSite. Pro skutečné načtení aplikací je potřeba same-origin hostování nebo serverový login/proxy.'
                    );
                }
            };

            const readAttributes = (xmlDocument, tagName, attributeNames) => {
                const element = xmlDocument.getElementsByTagName(tagName)[0];
                if (!element) {
                    return null;
                }

                const result = {};

                for (const attributeName of attributeNames) {
                    const attributeValue = element.getAttribute(attributeName);
                    if (attributeValue) {
                        result[attributeName] = attributeValue;
                    }
                }

                return Object.keys(result).length > 0 ? result : null;
            };

            const parseConfiguration = (xmlText) => {
                const parser = new DOMParser();
                const xmlDocument = parser.parseFromString(xmlText, 'application/xml');
                const parserError = xmlDocument.getElementsByTagName('parsererror')[0];

                if (parserError) {
                    throw new Error(parserError.textContent?.trim() || 'Neznámá chyba při parsování XML konfigurace.');
                }

                const configuration = {
                    authentication: readAttributes(xmlDocument, 'authentication', ['locationURL']),
                    authManager: readAttributes(xmlDocument, 'authManager', [
                        'getUsernameURL',
                        'getUserDetailsURL',
                        'logoffURL',
                        'changeCredentialsURL',
                        'webviewReturnURL',
                        'webviewResumeURL',
                        'allowSelfServiceAccountManagementURL'
                    ]),
                    resourcesProxy: readAttributes(xmlDocument, 'resourcesProxy', ['listURL', 'resourceDetails']),
                    protocolHandler: readAttributes(xmlDocument, 'protocolHandler', ['enabled']),
                    workspaceControl: readAttributes(xmlDocument, 'workspaceControl', ['enabled'])
                };

                const pluginAssistantElement = xmlDocument.getElementsByTagName('pluginAssistant')[0];
                if (pluginAssistantElement) {
                    const html5Element = pluginAssistantElement.getElementsByTagName('html5')[0];
                    if (html5Element) {
                        configuration.pluginAssistant = {
                            html5Enabled: html5Element.getAttribute('enabled') || ''
                        };
                    }
                }

                return configuration;
            };

            const showEmptyState = (message) => {
                appListElement.innerHTML = '';
                emptyStateElement.textContent = message;
                emptyStateElement.classList.remove('d-none');
            };

            const looksLikeUnauthorized = (response, responseText) => {
                const body = (responseText || '').toLowerCase();
                const finalUrl = (response.url || '').toLowerCase();
                const challengeHeader = (response.headers.get('CitrixWebReceiver-Authenticate') || '').toLowerCase();

                return response.status === 401
                    || response.status === 403
                    || response.redirected
                    || challengeHeader.includes('tokenrequired')
                    || body.includes('"unauthorized":true')
                    || body.includes('"unauthorized": true')
                    || body.includes('getauthmethods')
                    || body.includes('explicitauth')
                    || body.includes('log on')
                    || finalUrl.includes('/authentication/')
                    || finalUrl.includes('/explicitauth/');
            };

            const renderBridgeApplications = (resources, bridgeStoreRootUrl) => {
                appListElement.innerHTML = '';
                emptyStateElement.classList.add('d-none');
                emptyStateElement.textContent = '';

                const resolveBridgeUrl = (relPath) => {
                    try {
                        return new URL(relPath, bridgeStoreRootUrl).toString();
                    } catch (error) {
                        log.warn('SsoBridge', `Nepodařilo se složit URL z hodnoty "${relPath}": ${error instanceof Error ? error.message : String(error)}`);
                        return '';
                    }
                };

                for (const resource of resources) {
                    const iconUrl = resource.iconurl ? resolveBridgeUrl(resource.iconurl) : '';
                    const launchPath = resource.launchurl;

                    const listItem = document.createElement('li');
                    listItem.className = 'citrix-app-item';
                    listItem.style.cursor = launchPath ? 'pointer' : 'default';
                    listItem.title = launchPath ? `Spustit: ${resource.name}` : '(launchurl chybí)';

                    const image = document.createElement('img');
                    image.className = 'citrix-app-icon';
                    image.alt = resource.name || 'Citrix aplikace';
                    image.loading = 'lazy';
                    image.referrerPolicy = 'no-referrer';
                    image.src = iconUrl || 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';
                    image.addEventListener('error', () => {
                        log.warn('IconLoad', `Ikona se nepodařila načíst pro "${resource.name || '(bez názvu)'}": ${iconUrl || '(prázdná iconurl)'}`);
                    });

                    const name = document.createElement('div');
                    name.className = 'citrix-app-name';
                    name.textContent = resource.name || '(bez názvu)';

                    if (launchPath) {
                        listItem.addEventListener('click', () => {
                            log.info('Launch', `Klik na "${resource.name}" (SSO bridge relace).`);
                            const downloadUrl = resolveBridgeUrl(launchPath);
                            if (!downloadUrl) {
                                log.warn('Launch', 'Launch URL se nepodařilo sestavit.');
                                return;
                            }

                            const launcher = document.createElement('iframe');
                            launcher.style.display = 'none';
                            launcher.src = downloadUrl;
                            document.body.appendChild(launcher);
                            setTimeout(() => { try { launcher.remove(); } catch {} }, 10000);
                        });
                    }

                    listItem.appendChild(image);
                    listItem.appendChild(name);
                    appListElement.appendChild(listItem);
                }
            };

            // Tiché SSO: celý ověřený flow běží same-origin uvnitř skrytého iframe na 07.
            // Iframe je display:none (žádný popup, žádný viditelný prvek), žije jen po dobu
            // flow a hned se z DOM odstraní. Výsledek přiletí přes postMessage.
            const runSsoBridgeLogin = () => new Promise((resolve, reject) => {
                if (!ssoBridgeUrl) {
                    reject(new Error('SSO bridge URL není nastavena.'));
                    return;
                }

                let bridgeOrigin;
                try {
                    bridgeOrigin = new URL(ssoBridgeUrl).origin;
                } catch (error) {
                    reject(new Error(`Neplatná SSO bridge URL: ${error instanceof Error ? error.message : String(error)}`));
                    return;
                }

                let settled = false;

                const frame = document.createElement('iframe');
                frame.style.display = 'none';
                frame.setAttribute('aria-hidden', 'true');
                frame.title = 'Citrix SSO';

                const cleanup = () => {
                    window.removeEventListener('message', onMessage);
                    clearTimeout(timeoutHandle);
                    try { frame.remove(); } catch {}
                };

                const onMessage = (event) => {
                    // Origin kontrola: přijímej výsledek POUZE z origin bridge (server 07).
                    if (event.origin !== bridgeOrigin) {
                        return;
                    }

                    if (!event.data || event.data.type !== 'citrix-sso-result') {
                        return;
                    }

                    settled = true;
                    cleanup();

                    if (event.data.ok) {
                        resolve({
                            resources: Array.isArray(event.data.resources) ? event.data.resources : [],
                            bridgeOrigin
                        });
                    } else {
                        reject(new Error(event.data.error || 'SSO bridge vrátil chybu.'));
                    }
                };

                const timeoutHandle = setTimeout(() => {
                    if (!settled) {
                        settled = true;
                        cleanup();
                        reject(new Error('SSO přihlášení vypršelo (timeout 30 s).'));
                    }
                }, 30000);

                window.addEventListener('message', onMessage);
                frame.src = ssoBridgeUrl;
                document.body.appendChild(frame);
            });

            const openDiagnosticsPanel = () => {
                const diagDetails = document.querySelector('.citrix-diagnostics-details');
                if (diagDetails) {
                    diagDetails.open = true;
                }
            };

            const wireApiToolButtons = () => {
                const serverProbeBtn = document.getElementById('btn-server-probe');
                if (serverProbeBtn) {
                    serverProbeBtn.addEventListener('click', async () => {
                        if (!normalizedBaseUrl) {
                            log.error('ServerProbe', 'BaseUrl není nastavena — probe nelze spustit.');
                            openDiagnosticsPanel();
                            return;
                        }
                        openDiagnosticsPanel();
                        serverProbeBtn.disabled = true;
                        try {
                            const result = await runServerSideProbe('ServerProbe', normalizedBaseUrl, {
                                method: 'GET',
                                headers: {}
                            });
                            explainServerSideProbe('ServerProbe', result);
                        } finally {
                            serverProbeBtn.disabled = false;
                        }
                    });
                }
            };

            const run = async () => {
                log.info('Init', 'JS init started');
                log.info('Init', `RequestId: ${requestId}`);
                log.info('Init', `Panel title: ${root.dataset.panelTitle || '(neznámý)'}`);
                log.info('Init', `Použitá Citrix URL: ${rawBaseUrl || '(není nastaveno)'}`);
                log.info('Init', `Normalizovaná Citrix URL: ${normalizedBaseUrl || '(není nastaveno)'}`);
                log.info('Init', `BodyPreviewLimit: ${bodyPreviewLimit}`);
                log.info('Init', `Client log endpoint: ${clientLogEndpoint || '(není nastaveno)'}`);
                log.info('Init', `Server probe endpoint: ${serverProbeEndpoint || '(není nastaveno)'}`);
                log.info('Init', `Server login endpoint: ${serverLoginEndpoint || '(není nastaveno)'}`);
                log.info('Init', `Server SSO endpoint: ${serverSsoEndpoint || '(není nastaveno)'}`);
                log.info('Init', `SSO bridge URL: ${ssoBridgeUrl || '(není nastaveno)'}`);
                log.info('Init', `Browser origin: ${window.location.origin}`);
                log.info('Init', `Citrix URL origin: ${normalizedBaseUrl ? new URL(normalizedBaseUrl).origin : '(není nastaveno)'}`);

                wireApiToolButtons();

                if (retryButtonElement) {
                    retryButtonElement.addEventListener('click', () => { void startSso(); });
                }

                await startSso();
            };

            const startSso = async () => {
                showRetry(false);
                appListElement.innerHTML = '';
                emptyStateElement.classList.add('d-none');
                emptyStateElement.textContent = '';
                showSpinner('Načítám vaše aplikace…');
                setStatus('Probíhá tiché přihlášení…', 'info');

                if (STRATEGY !== 'bridge') {
                    hideSpinner();
                    setStatus('Neznámá strategie SSO.', 'error');
                    showEmptyState(`STRATEGY "${STRATEGY}" není v tomto buildu implementována — použijte "bridge".`);
                    return;
                }

                if (!ssoBridgeUrl) {
                    hideSpinner();
                    setStatus('SSO bridge URL není nastavena.', 'error');
                    log.error('SsoBridge', 'Konfigurace CitrixDiagnostics:SsoBridgeUrl chybí.');
                    showEmptyState('Chybí konfigurace SSO bridge URL.');
                    return;
                }

                try {
                    log.info('SsoBridge', `Spouštím tiché SSO přes skrytý iframe: ${ssoBridgeUrl}`);
                    const { resources, bridgeOrigin } = await runSsoBridgeLogin();
                    hideSpinner();
                    log.info('SsoBridge', `SSO bridge výsledek: ${resources.length} aplikací, origin=${bridgeOrigin}`);

                    if (resources.length > 0) {
                        const bridgeStoreRootUrl = new URL('../', ssoBridgeUrl).toString();
                        renderBridgeApplications(resources, bridgeStoreRootUrl);
                        setStatus(`Načteno ${resources.length} aplikací.`, 'success');
                        return;
                    }

                    log.warn('SsoBridge', 'SSO proběhlo, ale uživatel nemá žádné aplikace.');
                    setStatus('Přihlášení proběhlo, ale nemáte žádné aplikace.', 'warn');
                    showEmptyState('SSO proběhlo, ale seznam aplikací je prázdný.');
                } catch (ssoError) {
                    const msg = ssoError instanceof Error ? ssoError.message : String(ssoError);
                    hideSpinner();
                    log.error('SsoBridge', `SSO bridge selhal: ${msg}`);
                    setStatus('Automatické přihlášení selhalo.', 'error');
                    showEmptyState(msg);
                    showRetry(true);
                }
            };

            run().catch((error) => {
                log.error('Run', `Běh diagnostického PoC skončil výjimkou: ${error instanceof Error ? error.message : String(error)}`);
            });
        })();
    </script>
}
